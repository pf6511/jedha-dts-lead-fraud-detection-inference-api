# Copy to secrets.env (gitignored) for local runs.
# On the Hugging Face Space, define the same names as Space secrets.
MLFLOW_TRACKING_URI=https://your-mlflow-server
MLFLOW_TRACKING_TOKEN=token
MODEL_NAME=fraud-detection-random-forest
MODEL_ALIAS=production
# Shared with the processor. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
INFERENCE_API_KEY=
# MLflow artifact store (S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
